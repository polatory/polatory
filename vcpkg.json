{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "jizai",
  "version-string": "1.0.0",
  "dependencies": [
    "boost-algorithm",
    "boost-any",
    "boost-container",
    "boost-container-hash",
    "boost-filesystem",
    "boost-iterator",
    "boost-math",
    "boost-program-options",
    "boost-range",
    "boost-unordered",
    "ceres",
    "eigen3",
    "fast-float",
    "libigl",
    "nanoflann",
    "pocketfft",
    "xsimd",
    "xtensor",
    "xtensor-blas",
    "xtl"
  ],
  "default-features": [
    {
      "name": "armpl",
      "platform": "(windows | linux) & arm64"
    },
    {
      "name": "mkl",
      "platform": "(windows | linux) & x64"
    }
  ],
  "features": {
    "armpl": {
      "description": "Use Arm Performance Libraries",
      "dependencies": [
        "armpl"
      ]
    },
    "mkl": {
      "description": "Use Intel oneMKL",
      "dependencies": [
        "intel-mkl"
      ]
    },
    "python": {
      "description": "Build Python bindings",
      "dependencies": [
        "pybind11"
      ]
    },
    "tests": {
      "description": "Build unit tests",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
